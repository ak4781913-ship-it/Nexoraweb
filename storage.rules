rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'khanabs1512@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() &&
        firestore.exists(/databases/ai-studio-80b53fef-edbe-4c89-8e26-45393e1f5d49/documents/administrators/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() &&
        firestore.exists(/databases/ai-studio-80b53fef-edbe-4c89-8e26-45393e1f5d49/documents/administrators/$(request.auth.uid)) &&
        firestore.get(/databases/ai-studio-80b53fef-edbe-4c89-8e26-45393e1f5d49/documents/administrators/$(request.auth.uid)).data.role == 'Super Admin'
      );
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');
    }

    // Publicly readable media assets uploaded by verified administrators.
    // Folder path preserved for backward compatibility with existing Storage media.
    // Executables, scripts, and SVGs are strictly blocked; permanent delete requires Super Admin.
    match /nexora-media/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && folder in ['products', 'categories', 'updates', 'brand']
        && fileName.size() >= 1
        && fileName.size() <= 160
        && isValidImageUpload();
      allow delete: if isSuperAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
