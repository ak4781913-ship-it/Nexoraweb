# ============================================================================
# SERVER-SIDE ONLY ENVIRONMENT VARIABLES (Node / Cloud Run Backend - server.ts)
# NEVER prefix these with VITE_ or commit real secret values to GitHub.
# ============================================================================

# GEMINI_API_KEY: Required on the Node/Cloud Run backend for MAWA AI endpoints.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Primary hosted URL of the Node/Cloud Run service.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated trusted frontend origins allowed to call /api/*
# Example: "https://yourdomain.com,https://www.yourdomain.com"
ALLOWED_ORIGINS=""

# Optional distributed rate-limiting backend for multi-instance Cloud Run / Node hosts.
# If omitted, server.ts uses bounded single-instance in-memory rate-limit buckets.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================================
# BUILD & FRONTEND ENVIRONMENT VARIABLES (GitHub Actions / Hostinger Vite Build)
# ============================================================================

# SITE_URL: Production canonical domain used at build time for dist/sitemap.xml & dist/robots.txt.
# Leave empty until your final domain is active (retains documented placeholder).
SITE_URL=""

# Optional external Express/Cloud Run AI backend URL when serving static dist/ on Hostinger.
# Example: "https://api.yourdomain.com" (no trailing slash). Leave blank on same-origin Node hosts.
VITE_AI_API_URL=""

# Optional Firebase client configuration overrides (public client identifiers, not secrets).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
